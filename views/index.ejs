<div class="container-fluid py-4">
  <div class="row">
    <div class="col-xl-4 col-sm-6 mb-xl-0 mb-4">
      <div class="card">
        <div class="card-body p-3">
          <div class="row">
            <div class="col-8">
              <div class="numbers">
                <p class="text-sm mb-0 text-uppercase font-weight-bold">Full Name</p>
                <h5 class="font-weight-bolder">
                  <%= userData.surname %>
                </h5>
                <p class="mb-0">

                  <%= userData.othername %>
                </p>
              </div>
            </div>
            <div class="col-4 text-end">
              <div class="icon icon-shape bg-gradient-primary shadow-primary text-center rounded-circle">
                <i class="ni ni-money-coins text-lg opacity-10" aria-hidden="true"></i>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-xl-4 col-sm-6 mb-xl-0 mb-4">
      <div class="card">
        <div class="card-body p-3">
          <div class="row">
            <div class="col-9">
              <div class="numbers">
                <p class="text-sm mb-0 text-uppercase font-weight-bold">Email</p>
                <h5 class="font-weight-bolder text-capitalize">
                  <%= userData.role %> Email
                </h5>
                <p class="mb-0">
                  <span class="text-success text-sm font-weight-bolder">
                    <%= userData.email %>

                  </span>

                </p>
              </div>
            </div>
            <div class="col-2 text-end">
              <div class="icon icon-shape bg-gradient-danger shadow-danger text-center rounded-circle">
                <i class="ni ni-world text-lg opacity-10" aria-hidden="true"></i>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-xl-4 col-sm-6 mb-xl-0 mb-4">
      <div class="card">
        <div class="card-body p-3">
          <div class="row">
            <div class="col-8">
              <div class="numbers">
                <p class="text-sm mb-0 text-uppercase font-weight-bold">Date</p>
                <h5 class="font-weight-bolder">
                  Current Date
                </h5>
                <p class="mb-0">
                  <span class="text- text-sm font-weight-bolder" id="currentDate">-2%</span>
                </p>
              </div>
            </div>
            <div class="col-4 text-end">
              <div class="icon icon-shape bg-gradient-success shadow-success text-center rounded-circle">
                <i class="ni ni-paper-diploma text-lg opacity-10" aria-hidden="true"></i>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
  <div class="row mt-4">
    <div class="col-lg-7 mb-lg-0 mb-4">
      <div class="card ">
        <div class="card-header pb-0 p-3">
          <div class="d-flex justify-content-between">
            <h6 class="mb-2">Personal Information</h6>
          </div>
        </div>
        <div class="table-responsive">
          <table class="table align-items-center ">
            <tbody>
              <tr>
                <td class="w-30">
                  <div class="d-flex px-2 py-1 align-items-center">
                    <div>
                      <img src="../assets/img/icons/flags/GB.png" alt="Country flag">
                    </div>
                    <div class="ms-4">
                      <!-- <p class="text-xs font-weight-bold mb-0">Whatsapp :</p> -->
                      <h6 class="text-sm mb-0">Surname </h6>
                    </div>
                  </div>
                </td>
                <td>
                  <div class="text-center">

                    <h6 class="text-sm mb-0"> <%- userData.surname ? userData.surname : 'Empty' %>

                    </h6>
                  </div>
                </td>

              </tr>
              <tr>
                <td class="w-30">
                  <div class="d-flex px-2 py-1 align-items-center">
                    <div>
                      <img src="../assets/img/icons/flags/GB.png" alt="Country flag">
                    </div>
                    <div class="ms-4">
                      <!-- <p class="text-xs font-weight-bold mb-0">Whatsapp :</p> -->
                      <h6 class="text-sm mb-0">Other Name(s)</h6>
                    </div>
                  </div>
                </td>
                <td>
                  <div class="text-center">

                    <h6 class="text-sm mb-0"> <%- userData.othername ? userData.othername : 'Empty' %>

                    </h6>
                  </div>
                </td>

              </tr>
              <tr>
                <td class="w-30">
                  <div class="d-flex px-2 py-1 align-items-center">
                    <div>
                      <img src="../assets/img/icons/flags/US.png" alt="Country flag">
                    </div>
                    <div class="ms-4">
                      <!-- <p class="text-xs font-weight-bold mb-0">Data :</p> -->
                      <h6 class="text-sm mb-0"> Account Number</h6>
                    </div>
                  </div>
                </td>
                <td>
                  <div class="text-center">
                    <!-- <p class="text-xs font-weight-bold mb-0">Sales:</p> -->
                    <h6 class="text-sm mb-0"><%- userData.account_id %></h6>
                  </div>
                </td>

              </tr>
              <tr>
                <td class="w-30">
                  <div class="d-flex px-2 py-1 align-items-center">
                    <div>
                      <img src="../assets/img/icons/flags/DE.png" alt="Country flag">
                    </div>
                    <div class="ms-4">
                      <!-- <p class="text-xs font-weight-bold mb-0">Country:</p> -->
                      <h6 class="text-sm mb-0">Phone Number</h6>
                    </div>
                  </div>
                </td>
                <td>
                  <div class="text-center">
                    <!-- <p class="text-xs font-weight-bold mb-0">Sales:</p> -->
                    <h6 class="text-sm mb-0"><%- userData.phone_number %></h6>
                  </div>
                </td>

              </tr>
              <tr>
                <td class="w-30">
                  <div class="d-flex px-2 py-1 align-items-center">
                    <div>
                      <img src="../assets/img/icons/flags/GB.png" alt="Country flag">
                    </div>
                    <div class="ms-4">
                      <!-- <p class="text-xs font-weight-bold mb-0">Whatsapp :</p> -->
                      <h6 class="text-sm mb-0">Whatsapp </h6>
                    </div>
                  </div>
                </td>
                <td>
                  <div class="text-center">

                    <h6 class="text-sm mb-0"> <%- userData.whatsapp ? userData.whatsapp : 'Empty' %>

                    </h6>
                  </div>
                </td>

              </tr>
              <tr>
                <td class="w-30">
                  <div class="d-flex px-2 py-1 align-items-center">
                    <div>
                      <img src="../assets/img/icons/flags/BR.png" alt="Country flag">
                    </div>
                    <div class="ms-4">
                      <!-- <p class="text-xs font-weight-bold mb-0">User Role:</p> -->
                      <h6 class="text-sm mb-0">User Role</h6>
                    </div>
                  </div>
                </td>
                <td>
                  <div class="text-center">
                    <!-- <p class="text-xs font-weight-bold mb-0"><%- userData.role %>:</p> -->
                    <h6 class="text-sm mb-0 text-capitalize"><%- userData.role %></h6>
                  </div>
                </td>

              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    <div class="col-lg-5">
      <div class="card card-carousel overflow-hidden h-100 p-0">
        <div id="carouselExampleCaptions" class="carousel slide h-100" data-bs-ride="carousel">
          <div class="carousel-inner border-radius-lg h-100">
            <div class="carousel-item h-100 active" style="background-image: url('../assets/img/carousel-1.jpg');
    background-size: cover;">
              <div class="carousel-caption d-none d-md-block bottom-0 text-start start-0 ms-5">
                <div class="icon icon-shape icon-sm bg-white text-center border-radius-md mb-3">
                  <i class="ni ni-camera-compact text-dark opacity-10"></i>
                </div>
                <h5 class="text-white mb-1">Welcome, <%= userData.surname %>
                </h5>
                <p>
                  Your dashboard is your command center<br>Track progress, manage tasks, and explore insights
                  effortlessly. <br> 💡 Need help? We’re here for you! 🚀
                </p>
              </div>
            </div>
            <div class="carousel-item h-100" style="background-image: url('../assets/img/carousel-2.jpg');
    background-size: cover;">
              <div class="carousel-caption d-none d-md-block bottom-0 text-start start-0 ms-5">
                <div class="icon icon-shape icon-sm bg-white text-center border-radius-md mb-3">
                  <i class="ni ni-bulb-61 text-dark opacity-10"></i>
                </div>
                <h5 class="text-white mb-1">Hello <%= userData.username %> ,</h5>
                <p>Every great achievement starts with a single action. <br>Take control of your tasks, track your progress,
                  and move closer to your goals today. 💪</p>
              </div>
            </div>
            <div class="carousel-item h-100" style="background-image: url('../assets/img/carousel-3.jpg');
    background-size: cover;">
              <div class="carousel-caption d-none d-md-block bottom-0 text-start start-0 ms-5">
                <div class="icon icon-shape icon-sm bg-white text-center border-radius-md mb-3">
                  <i class="ni ni-trophy text-dark opacity-10"></i>
                </div>
                <h5 class="text-white mb-1">🛡 Security Tips!</h5>
                <p>
                  🔹 Beware of any fraudulent emails <br>
                  🔹 Never share your login details <br>
                  🔹 Update your password as soon as you need to <br>
                  Your digital safety matters. Stay vigilant, stay secure!
                </p>
              </div>
            </div>
          </div>
          <button class="carousel-control-prev w-5 me-3" type="button" data-bs-target="#carouselExampleCaptions"
            data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
          </button>
          <button class="carousel-control-next w-5 me-3" type="button" data-bs-target="#carouselExampleCaptions"
            data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
          </button>
        </div>
      </div>
    </div>
  </div>




  <script>
    function formatDate() {
      const date = new Date();
      const days = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
      const day = days[date.getDay()];
      const dayOfMonth = date.getDate();
      const year = date.getFullYear();

      document.getElementById("currentDate").innerText = `${day} ${dayOfMonth}, ${year}`;
    }

    // Call function on page load
    formatDate();
  </script>
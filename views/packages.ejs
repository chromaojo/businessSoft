<main id="main">

  <!-- ======= Breadcrumbs ======= -->
  <section class="breadcrumbs">
    <div class="container">

      <div class="d-flex justify-content-between align-items-center">
        <h2>Packages</h2>
        <ol>
          <li><a href="/">Home</a></li>
          <li>Packages</li>
        </ol>
      </div>

    </div>
  </section><!-- End Breadcrumbs -->

  <section class="inner-page">
    <div class="container" id="packages">
     <div class="row">
      <% userPack.forEach(trans=> { %>
        <div class="col-md-6">
          <div class="row g-0 border rounded overflow-hidden flex-md-row mb-4 shadow-sm h-md-250 position-relative">
            <div class="col p-4 d-flex flex-column position-static">
              <strong class="d-inline-block mb-2 text-success">Business Solution</strong>
              <h3 class="mb-0"><%= trans.title %></h3>
              <!-- <div class="mb-1 text-muted">NGN <%= trans.price %></div> -->
              <p class="mb-auto"><%= trans.detail %></p>
              <a href="/user/packages/<%= trans.id %>" class="stretched-link">Continue reading</a>
            </div>
            <div class="col-auto d-none d-lg-block">
              <img src="" alt="" class="bd-placeholder-img" width="200" height="250">
              <!-- <svg  xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Placeholder: Thumbnail" preserveAspectRatio="xMidYMid slice" focusable="false"><title>Placeholder</title><rect width="100%" height="100%" fill="#55595c"/><text x="50%" y="50%" fill="#eceeef" dy=".3em">Thumbnail</text></svg> -->
    
            </div>
          </div>
        </div>

        <% }) %>
     </div>
    </div>

    
  </section>

</main><!-- End #main -->
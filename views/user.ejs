<main id="main">

    <!-- ======= Breadcrumbs ======= -->
    <section class="breadcrumbs">
        <div class="container">

            <div class="d-flex justify-content-between align-items-center">
                <h2><b>Users</b></h2>
                <ol>
                    <li><a href="/">Home</a></li>
                    <li>Users</li>
                </ol>
            </div>

        </div>
    </section><!-- End Breadcrumbs -->

    <section class="inner-page">
        <div class="container p-3" id="user">
            <% let counter=1; %>
                <!-- Add A Carousel for the form  -->
                
                <table class="table datatable">
                    <thead>
                        <th>S/N</th>
                        <th> Email </th>
                        <th>Role</th>
                        <th>Password Reset</th>
                        <th>Edit</th>
                    </thead>
                    <tbody>
                        <% userAll.forEach(trans=> { %>
                            <tr>
                                <td>
                                    <%= counter++ %>
                                </td>
                                <td>
                                    <a href="">
                                        <%= trans.email %>
                                    </a>
                                </td>
                                <td>
                                    <a href="">
                                        <%= trans.role %>
                                    </a>
                                </td>
                                <td>
                                    <a href="">
                                        <span>*************</span>
                                    </a>
                                </td>
                                <td>
                                    <a href="/admin/users/<%= trans.user_id %>" class="btn btn-outline-danger">Edit</a>
                                </td>
                            </tr>

                            <% }) %>
                    </tbody>
                </table>
        </div>
    </section>

</main><!-- End #main -->
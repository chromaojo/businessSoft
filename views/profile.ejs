              <div class="d-flex align-items-center justify-content-center">
                <!-- <span class="me-2 text-xs font-weight-bold">60%</span> -->
                <div>
                  <% if (userData.address==null) { %>
                    <div class="progress">
                      <div class="progress-bar bg-gradient-danger" role="progressbar" aria-valuenow="10"
                        aria-valuemin="0" aria-valuemax="100" style="width: 10%;">
                      </div>
                    </div>
                    <% } else { %>
                      <div class="progress">
                        <div class="progress-bar bg-gradient-info" role="progressbar" aria-valuenow="70"

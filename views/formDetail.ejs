<main id="main">

  <section class="section p-4" id="forms">

    <div class="row">
      <div class="col-lg-12">
        <div class="card">
          <h2 class="p-4">
            <b>Form Details</b>
            <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#basicModal">
              Add A Field
            </button>
            <a class="btn btn-outline-danger" href="/admin/forms/del/<%= form.form_id %>">Delete Form</a>
          </h2>
          <div class="card-body">
            <h3 class="card-title p-2"> <%= form.form_name %></h5>
              <p class="p-2"><%= form.description %></p>
              <b class="p-2" >Form By : <i><%= form.createdby %></i></b>
           

            <!-- Basic Modal -->
         
            <div class="modal fade" id="basicModal" tabindex="-1">
              <div class="modal-dialog">
                <div class="modal-content">
                  <div class="modal-header">
                    <h5 class="modal-title">Create Fields For The Form</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                  </div>
                  <div class="modal-body">
                   
                    <div class="card p-4"> 
                      <form action="/<%= userData.role %>/fieldz/ZxXTyGWPLRfD/<%= form.form_id %>"  method="post" class="php-email-form">
                        <div class="row gy-4">
                          <div class="col-md-12">
                            <label for="name">Question</label>
                            <input type="text" name="field_name" class="form-control" placeholder="Enter A Question or Field">
                          </div>
                          <div class="col-md-12">
                            <label for="name">Question Explanation</label>
                            <input type="text" name="field_options" class="form-control" placeholder="Enter An Explanation If Needed">
                          </div>
                          <div class="col-md-12">
                            <label for="field_type">Type Of Answers</label>
                            <select name="field_type"  class="form-control" required>
                              <option value="">Select One</option> <hr>
                              <option value="email"> Email</option>
                              <option value="textarea"> Long Text</option>
                              <option value="number"> Number</option>
                              <option value="text">Short Answer</option>
                            </select>
                          </div>
                          <div class="col-md-12">
                            <label for="Required">Required | </label> <span>Yes</span>
                            <input type="radio" name="is_requiredz"  value="TRUE"> <span>No</span>
                            <input type="radio" name="is_requiredz" value="FALSE">
                          </div>            
                        </div>

                    </div>
                  </div>
                  <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Add</button></form>

                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>

                  </div>
                </div>
              </div>
            </div><!-- End Basic Modal-->

          </div>
        </div>
      </div>
    </div> <br>
    <hr> <br>


    <div class="row">
      <div class="col-lg-12">

        <div class="card">
          <div class="card-body">
            <h5 class="card-title"> Survey / Lead Section</h5>
            <p class="text-capitalize">

            </p>

            <% if (formData=='' ) { %>
              <br> <br>
              <h3 class="m-5 text-center mb-5">There is no Field Data at the moment</h3>

              <% } else{%>
               
                <!-- Table with stripped rows -->
                <table class="table datatable">
                  <thead>
                    <% let counter=1 %>
                      <tr>
                        <th scope="col">#</th>

                        <th scope="col">Question</th>
                        <th scope="col">Answer Type</th>
                        <th scope="col">Explanation</th>
                        <th></th>
                        <th></th>
                      </tr>
                  </thead>
                  <tbody>
                    <% formData.forEach(trans=> { %>
                      <tr>
                        <th scope="row">
                          <%= counter++ %>
                        </th>
                        <td>
                          <%= trans.field_name %>
                        </td>
                        <td class="text-capitalize">
                          <%= trans.field_type %>
                        </td>
                        <td>
                          <%= trans.field_options %>
                        </td>
                        <td>
                          <span class="badge bg-warning">Edit...</span>
                        </td>
                        <td>
                          <span class="badge bg-danger">Delete...</span>
                        </td>
                      </tr>

                      <% }) %>

                  </tbody>
                </table>
                <!-- End Table with stripped rows -->
                <% } %>



          </div>
        </div>

      </div>
    </div>
  </section>

</main>